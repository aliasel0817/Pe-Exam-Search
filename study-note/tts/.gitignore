# Generated or sensitive local files must never be committed by default.
/audio/**/*.mp3
/private-tts-ledger.json
/private-tts-ledger.json.lock
/*-sample-*.json
/topics*.json
*.pending
__pycache__/
*.pyc

# Keep locally generated MP3 and audio indexes out of the public GitHub repository.
/audio/
/audio-pilot-local/
/audio-*/
*.mp3
/topic-sample.json
/topic-sample-*.json
/topic-export*.json
/private-topics*.json
